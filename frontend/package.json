{
  "name": "habiton",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:pages": "vite build --base=/habiton/",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages -d dist --dotfiles",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write src scripts tests vite.config.js README.md docs/*.md"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "6.1.1",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  }
}
